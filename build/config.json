{
    // Tool -> the extensions it compiles. Outputs keep the asset's path, compiled or not. Files with any other extension
    // are copied as is. See build/README.md.
    "tools": {
        "texc": {
            "extensions": [ ".tex" ],
            "args": ["--root", "$root", "--depfile", "$out.d", "-o", "$out", "$in"],
            "depfile": "$out.d"
        },
        "matc": {
            "extensions": [ ".mat", ".matinst" ],
            "args": ["--root", "$root", "--depfile", "$out.d", "-o", "$out", "$in"],
            "depfile": "$out.d"
        },
        "modelc": {
            "extensions": [ ".model" ],
            "args": ["--root", "$root", "--depfile", "$out.d", "-o", "$out", "$in"],
            "depfile": "$out.d"
        },
        "lightc": {
            "extensions": [ ".light" ],
            "args": ["--root", "$root", "--depfile", "$out.d", "-o", "$out", "$in"],
            "depfile": "$out.d"
        }
    }
}
