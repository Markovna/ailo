{
    "source": ".source/vaisso.fbx",
    // The FBX names both parts "Vaisseau" and its geometry carries no material layer, so the importer gives both meshes
    // one default material: the hull takes "material", and the cockpit, the inner node, is picked by its path.
    "material": "hull.matinst",
    "nodeMaterials": { "Vaisseau/Vaisseau": "cockpit.matinst" }
}
