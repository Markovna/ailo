material {
    "name": "Lit",
    "shadingModel": "lit",
    // color: the meshes provide it, and declaring it keeps the vertex inputs matching the pipeline layout
    "requires": ["color", "uv0", "tangents"],
    "parameters": [
        { "type": "sampler2d", "name": "baseColorMap", "default": "white" },
        { "type": "sampler2d", "name": "normalMap", "default": "normal" },
        { "type": "sampler2d", "name": "metallicRoughnessMap", "default": "white" },
        // Occlusion is read from red, so a glTF occlusion/roughness/metallic texture can be bound here as well.
        { "type": "sampler2d", "name": "occlusionMap", "default": "white" },
        { "type": "sampler2d", "name": "emissiveMap", "default": "white" },
        { "type": "float4", "name": "baseColorFactor", "default": [1, 1, 1, 1] },
        { "type": "float", "name": "metallicFactor", "default": 1 },
        { "type": "float", "name": "roughnessFactor", "default": 1 },
        { "type": "float", "name": "occlusionStrength", "default": 1 },
        { "type": "float3", "name": "emissiveFactor", "default": [0, 0, 0] }
    ],
    "blending": "opaque",
    "culling": "back"
}

fragment {
    void material(inout MaterialInputs material) {
        material.normal = unpackNormalMap(texture(materialParams_normalMap, getUV0()));
        prepareMaterial(material);

        material.baseColor = texture(materialParams_baseColorMap, getUV0()) * materialParams.baseColorFactor;
        vec3 metallicRoughness = texture(materialParams_metallicRoughnessMap, getUV0()).rgb;
        material.metallic = metallicRoughness.b * materialParams.metallicFactor;
        material.roughness = metallicRoughness.g * materialParams.roughnessFactor;
        if (hasTexture(occlusionMap)) {
            float occlusion = texture(materialParams_occlusionMap, getUV0()).r;
            material.ambientOcclusion = mix(1.0, occlusion, materialParams.occlusionStrength);
        }
        material.emissive = materialParams.emissiveFactor;
        if (any(greaterThan(materialParams.emissiveFactor, vec3(0.0)))) {
            material.emissive *= texture(materialParams_emissiveMap, getUV0()).rgb;
        }
    }
}
