material {
    "name": "Tonemap",
    "domain": "postprocess",
    "parameters": [
        { "type": "sampler2d", "name": "color" }
    ]
}

fragment {
    const float kWhitePoint = 4.0;

    vec3 reinhardExtended(vec3 x) {
        return min(x * (1.0 + x / (kWhitePoint * kWhitePoint)) / (1.0 + x), 1.0);
    }

    void postProcess(inout PostProcessInputs postProcess) {
        // The HDR target and the output have the same size.
        vec3 color = texelFetch(materialParams_color, ivec2(gl_FragCoord.xy), 0).rgb * getExposure();
        postProcess.color = vec4(reinhardExtended(color), 1.0);
    }
}
